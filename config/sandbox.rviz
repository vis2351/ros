Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.3
      Plane: XY
    - Class: rviz_default_plugins/Path
      Name: Route
      Enabled: true
      Topic:
        Value: /route
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 255; 200; 20
      Line Style: Lines
      Line Width: 0.02
    - Class: rviz_default_plugins/Marker
      Name: Vehicle
      Enabled: true
      Topic:
        Value: /vehicle_marker
    - Class: rviz_default_plugins/Marker
      Name: Traffic Light
      Enabled: true
      Topic:
        Value: /traffic_light_marker
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Background Color: 35; 43; 55
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.52
      Yaw: 0
Window Geometry:
  Width: 1100
  Height: 760
